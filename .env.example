# Environment Variables Template
# Copy this to .env.local for local development
# For deployment: Set these in your platform's environment variables

# Google Gemini API (Required for AI content generation)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API (Optional - enables real video search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OAuth Credentials (Optional - for user authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
